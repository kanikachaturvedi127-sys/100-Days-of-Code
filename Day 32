Q63: Merge two arrays.

/*
#include <stdio.h>

int main() {
    int n, m, i;
    int a[100], b[100], merged[200];

    // Read first array
    scanf("%d", &n);
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    // Read second array
    scanf("%d", &m);
    for (i = 0; i < m; i++) {
        scanf("%d", &b[i]);
    }

    // Copy first array into merged array
    for (i = 0; i < n; i++) {
        merged[i] = a[i];
    }

    // Copy second array after first array
    for (i = 0; i < m; i++) {
        merged[n + i] = b[i];
    }

    // Print merged array
    for (i = 0; i < n + m; i++) {
        printf("%d ", merged[i]);
    }

    return 0;
}
Q64: Find the digit that occurs the most times in an integer number.

/*
#include <stdio.h>

int main() {
    long long n;
    int freq[10] = {0};
    int digit, i, max = 0, result = 0;

    scanf("%lld", &n);

    // Count frequency of each digit
    while (n > 0) {
        digit = n % 10;
        freq[digit]++;
        n = n / 10;
    }

    // Find the digit with maximum frequency
    for (i = 0; i <= 9; i++) {
        if (freq[i] > max) {
            max = freq[i];
            result = i;
        }
    }

    printf("%d", result);

    return 0;
}
