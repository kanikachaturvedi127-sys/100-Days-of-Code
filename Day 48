Q95: Check if one string is a rotation of another.

/*
#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100], temp[200];

    scanf("%s", str1);
    scanf("%s", str2);

    if (strlen(str1) != strlen(str2)) {
        printf("Not rotation");
        return 0;
    }

    strcpy(temp, str1);
    strcat(temp, str1);

    if (strstr(temp, str2) != NULL)
        printf("Rotation");
    else
        printf("Not rotation");

    return 0;
}

Q96: Reverse each word in a sentence without changing the word order.

/*
#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, j, start;

    fgets(str, sizeof(str), stdin);

    start = 0;

    for (i = 0; ; i++) {
        if (str[i] == ' ' || str[i] == '\n' || str[i] == '\0') {

            for (j = i - 1; j >= start; j--) {
                printf("%c", str[j]);
            }

            if (str[i] == ' ')
                printf(" ");

            start = i + 1;
        }

        if (str[i] == '\0' || str[i] == '\n')
            break;
    }

    return 0;
}
