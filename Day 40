Q79: Perform diagonal traversal of a matrix.

/*
#include <stdio.h>

int main() {
    int rows, cols, i, j, d;
    int matrix[100][100];

    scanf("%d %d", &rows, &cols);

    // Read matrix
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Diagonal traversal
    for (d = 0; d < rows + cols - 1; d++) {
        // Start from the top row or left column
        if (d < cols) {
            i = 0;
            j = d;
        } else {
            i = d - cols + 1;
            j = cols - 1;
        }

        // Traverse diagonal from top-right to bottom-left
        while (i < rows && j >= 0) {
            printf("%d ", matrix[i][j]);
            i++;
            j--;
        }
    }

    return 0;
}
Q80: Multiply two matrices.

/*
#include <stdio.h>

int main() {
    int r1, c1, r2, c2;
    int i, j, k;
    int A[100][100], B[100][100], result[100][100];

    // Read dimensions of first matrix
    scanf("%d %d", &r1, &c1);

    // Read first matrix
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c1; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    // Read dimensions of second matrix
    scanf("%d %d", &r2, &c2);

    // Read second matrix
    for (i = 0; i < r2; i++) {
        for (j = 0; j < c2; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    // Initialize result matrix
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c2; j++) {
            result[i][j] = 0;
        }
    }

    // Matrix multiplication
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c2; j++) {
            for (k = 0; k < c1; k++) {
                result[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // Print result
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c2; j++) {
            printf("%d ", result[i][j]);
        }
        printf("\n");
    }

    return 0;
}
