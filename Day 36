Q71: Read and print a matrix.

/*
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int matrix[100][100];

    scanf("%d %d", &rows, &cols);

    // Read matrix elements
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Print matrix
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("%d ", matrix[i][j]);
        }
        printf("\n");
    }

    return 0;
}
Q72: Find the sum of all elements in a matrix.

/*
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int matrix[100][100];
    int sum = 0;

    scanf("%d %d", &rows, &cols);

    // Read matrix and calculate sum
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &matrix[i][j]);
            sum += matrix[i][j];
        }
    }

    printf("%d", sum);

    return 0;
}
