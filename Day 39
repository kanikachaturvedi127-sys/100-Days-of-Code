Q77: Check if the elements on the diagonal of a matrix are distinct.

/*
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int matrix[100][100];
    int distinct = 1;

    scanf("%d %d", &rows, &cols);

    // Read matrix
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Compare diagonal elements
    for (i = 0; i < rows && i < cols; i++) {
        for (j = i + 1; j < rows && j < cols; j++) {
            if (matrix[i][i] == matrix[j][j]) {
                distinct = 0;
                break;
            }
        }

        if (distinct == 0) {
            break;
        }
    }

    if (distinct) {
        printf("True");
    } else {
        printf("False");
    }

    return 0;
}
Q78: Find the sum of main diagonal elements for a square matrix.

/*
#include <stdio.h>

int main() {
    int n, i, j;
    int matrix[100][100];
    int sum = 0;

    scanf("%d %d", &n, &j);

    // Read matrix
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Calculate main diagonal sum
    for (i = 0; i < n; i++) {
        sum += matrix[i][i];
    }

    printf("%d", sum);

    return 0;
}
