Q75: Add two matrices.

/*
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int A[100][100], B[100][100], sum[100][100];

    // Read dimensions
    scanf("%d %d", &rows, &cols);

    // Read first matrix
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    // Read second matrix
    scanf("%d %d", &rows, &cols);

    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    // Add matrices
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            sum[i][j] = A[i][j] + B[i][j];
        }
    }

    // Print result
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("%d ", sum[i][j]);
        }
        printf("\n");
    }

    return 0;
}
Q76: Check if a matrix is symmetric.

/*
#include <stdio.h>

int main() {
    int n, i, j;
    int matrix[100][100];
    int symmetric = 1;

    scanf("%d", &n);

    // Read matrix
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Check symmetry
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (matrix[i][j] != matrix[j][i]) {
                symmetric = 0;
                break;
            }
        }

        if (symmetric == 0) {
            break;
        }
    }

    if (symmetric) {
        printf("True");
    } else {
        printf("False");
    }

    return 0;
}
