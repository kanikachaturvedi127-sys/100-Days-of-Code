Q109 (Logic Enhancers)

Write a program to take an integer array arr and an integer k as inputs. Print the maximum sum of all the subarrays of size k.

#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int main() {
    int n, k;
    cin >> n;

    vector<int> arr(n);

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cin >> k;

    if (k <= 0 || k > n) {
        cout << -1;
        return 0;
    }

    int maxSum = INT_MIN;

    for (int i = 0; i <= n - k; i++) {

        int sum = 0;

        for (int j = i; j < i + k; j++) {
            sum += arr[j];
        }

        maxSum = max(maxSum, sum);
    }

    cout << maxSum;

    return 0;
}
