Q97: Print the initials of a name.

/*
#include <stdio.h>

int main() {
    char str[100];
    int i;

    fgets(str, sizeof(str), stdin);

    // Print first character
    if (str[0] != ' ')
        printf("%c.", str[0]);

    // Print character after every space
    for (i = 1; str[i] != '\0'; i++) {
        if (str[i - 1] == ' ' && str[i] != ' ' && str[i] != '\n') {
            printf("%c.", str[i]);
        }
    }

    return 0;
}
Q98: Print initials of a name with the surname displayed in full.

/*
#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, lastSpace = -1;

    fgets(str, sizeof(str), stdin);

    // Find the last space (before surname)
    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ')
            lastSpace = i;
    }

    // Print initials of first/middle names
    printf("%c.", str[0]);

    for (i = 1; i < lastSpace; i++) {
        if (str[i - 1] == ' ' && str[i] != ' ')
            printf("%c.", str[i]);
    }

    // Print surname in full
    printf(" %s", &str[lastSpace + 1]);

    return 0;
}
